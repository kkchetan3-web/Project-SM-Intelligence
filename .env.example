# =============================================================================
# Copy to .env and fill in only if you run against live sources.
# Nothing here is required for tests or for the synthetic-control pipeline.
# NEVER commit a real .env file.
# =============================================================================

# Optional: route requests through a proxy if your network requires one.
# SM_INTEL_HTTP_PROXY=
# SM_INTEL_HTTPS_PROXY=

# Optional: override the default User-Agent. Please keep it honest and
# identifiable, and keep the crawl rate low.
# SM_INTEL_USER_AGENT=

# Optional: where databases live (defaults to config/project.yaml).
# SM_INTEL_DATABASE_ROOT=

# Optional: logging verbosity (DEBUG|INFO|WARNING|ERROR).
SM_INTEL_LOG_LEVEL=INFO

# Optional: fixed seed for any stochastic procedure.
SM_INTEL_RANDOM_SEED=20250101
